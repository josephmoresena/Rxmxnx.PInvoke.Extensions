<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!-- Imported only on an Apple Silicon host. These properties apply when that host compiles x86_64. -->
    <PropertyGroup Condition="'$(XamMacArch)' == 'x86_64'">
        <MonoBundlingExtraArgs>--link_flags=-Wl,-rpath,/usr/lib/swift</MonoBundlingExtraArgs>
    </PropertyGroup>

    <UsingTask TaskName="PrependPath" TaskFactory="CodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Dir Required="true"/>
        </ParameterGroup>
        <Task>
            <Using Namespace="System"/>
            <Code Type="Fragment" Language="cs"><![CDATA[
                var path = Environment.GetEnvironmentVariable("PATH") ?? "";
                if (!path.StartsWith(Dir + ":", StringComparison.Ordinal))
                    Environment.SetEnvironmentVariable("PATH", Dir + ":" + path);
            ]]></Code>
        </Task>
    </UsingTask>

    <Target Name="UseX64Clang" BeforeTargets="_CompileToNative" Condition="'$(XamMacArch)' == 'x86_64'">
        <PrependPath Dir="$(MSBuildProjectDirectory)/tools"/>
    </Target>
</Project>
