<Project>
    <PropertyGroup>
        <TargetFrameworks Condition="'$(MSBuildRuntimeType)' != 'Mono'">netstandard2.1;netstandard2.0;net452</TargetFrameworks>
        <LangVersion>8.0</LangVersion>
        <OutputType>Library</OutputType>
        <Deterministic>true</Deterministic>
        <Optimize>true</Optimize>
        <DefineConstants Condition="'$(MSBuildRuntimeType)' == 'Mono'">$(DefineConstants);MONO</DefineConstants>
        <AssemblyName Condition="$(AssemblyName.StartsWith('System')) And ('$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'net452')">$(AssemblyName).Empty</AssemblyName>
    </PropertyGroup>

    <Import Condition="'$(MSBuildRuntimeType)' == 'Mono'" Project="..\MonoProject.props"/>

    <PropertyGroup Condition="$(FacadeVersion) != ''">
        <Version>$(FacadeVersion)</Version>
        <AssemblyVersion>$(FacadeVersion)</AssemblyVersion>
        <Company>Mono development team</Company>
        <Product>Mono Common Language Infrastructure</Product>
        <Copyright>(c) Various Mono authors</Copyright>
        <Description>$(AssemblyName)</Description>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
        <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage"/>
    </ItemGroup>

    <ItemGroup Condition="$(AssemblyName.StartsWith('System'))">
        <AssemblyAttribute Include="System.Reflection.AssemblyDefaultAlias">
            <_Parameter1>$(AssemblyName)</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
