<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup Condition="'$(MultipleFrameworkTest)' != 'true'">
        <TargetFrameworks>$(DefaultFramework);netstandard2.1;netstandard2.0</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('WINDOWS'))">$(TargetFrameworks);net472</TargetFrameworks>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MultipleFrameworkTest)' == 'true'">
        <TargetFrameworks>$(DefaultFrameworks);net8.0;net7.0;net6.0;netstandard2.1;netstandard2.0</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('WINDOWS'))">$(TargetFrameworks);net462;net470;net471;net472</TargetFrameworks>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MultipleFrameworkTest)' == 'true' And '$(OnlySupportedFrameworkTest)' != 'true'">
        <TargetFrameworks>$(TargetFrameworks);net5.0;netcoreapp3.1;netcoreapp3.0;netcoreapp2.1;netcoreapp2.0</TargetFrameworks>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MultipleFrameworkTest)' == 'true' And ('$(OnlySupportedFrameworkTest)' != 'true' Or ($([MSBuild]::IsOSPlatform('WINDOWS')) And '$(GITHUB_ACTIONS)' == 'true'))">
        <TargetFrameworks>$(TargetFrameworks);net452;net46;net461</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Rxmxnx.PInvoke.Tests</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
        <DefineConstants Condition="'$(MultipleFrameworkTest)' == 'true'">$(DefineConstants);MULTIPLE_FRAMEWORK</DefineConstants>
        <NoWarn Condition="'$(TargetFramework)' == 'netstandard2.1'">$(NoWarn);MSB3243</NoWarn>
        <NoWarn Condition="'$(TargetFramework)' == 'netcoreapp2.0'">$(NoWarn);NU1902;NU1903;NETSDK1023</NoWarn>
        <SuppressTfmSupportBuildWarnings Condition="'$(TargetFramework)' == 'netcoreapp2.0'">true</SuppressTfmSupportBuildWarnings>
        <!-- Coverlet's XPlat collector cannot load on netcoreapp2.0 testhost. -->
        <VSTestCollect Condition="'$(CollectXPlatCoverage)' == 'true' And '$(TargetFramework)' != 'netcoreapp2.0'">XPlat Code Coverage</VSTestCollect>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFrameworkIdentifier)' != '.NETFramework' And '$(TargetFramework)' != 'netcoreapp2.0' And '$(TargetFramework)' != 'netstandard2.0'">
        <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1"/>
        <PackageReference Include="AutoFixture" Version="4.18.1"/>
        <ProjectReference Include="$(MSBuildThisFileDirectory)Rxmxnx.Assert.Tests\Rxmxnx.Assert.Tests.csproj"/>
    </ItemGroup>

    <Import Condition="'$(TargetFrameworkIdentifier)' != '.NETStandard'" Project="DotnetCoreAppTests.props"/>

</Project>
