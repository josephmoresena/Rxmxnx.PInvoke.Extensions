<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <Import Project="..\MonoProject.props"/>
    <Import Project="..\MonoFacades\System.Text.Json.Mono.props"/>

    <PropertyGroup>
        <AssemblyName>$(AssemblyName).mono</AssemblyName>
        <!-- Ubuntu's Mono 6.14 corlib exposes ReadOnlySpan's indexer as a plain byref. csc 3.9 rejects it. -->
        <DefineConstants Condition="'$(MONO_SPAN_BYREF_INDEXER)' == 'true'">$(DefineConstants);MONO_SPAN_BYREF_INDEXER</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Mono.ILLink.Descriptors.xml">
            <LogicalName>$(AssemblyName).xml</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

</Project>
